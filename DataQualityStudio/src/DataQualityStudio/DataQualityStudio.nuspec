<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata minClientVersion="5.3">
    <!-- Package id must be unique on nuget.org; keep it stable once published -->
    <id>VikashKumar.XrmToolBox.DataQualityStudio</id>
    <!-- Keep in sync with <Version> in DataQualityStudio.csproj (format 1.YYYY.M.rev) -->
    <version>1.2026.10.1</version>
    <title>Data Quality Studio</title>
    <authors>Vikash Kumar</authors>
    <owners>vikashkumar669</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/vikashkumar669/XrmTools/tree/main/DataQualityStudio</projectUrl>
    <repository type="git" url="https://github.com/vikashkumar669/XrmTools.git" branch="main" />
    <icon>images\icon.png</icon>
    <iconUrl>https://raw.githubusercontent.com/vikashkumar669/XrmTools/main/DataQualityStudio/src/DataQualityStudio/Resources/icon128.png</iconUrl>
    <readme>docs\README.md</readme>
    <description>Dataverse Excel Mapping &amp; Data Quality Studio: a configuration-driven import validator for teams working with Excel migration templates. Map Excel or CSV headers to Dataverse columns by display or logical name, validate required fields, data types, lengths, ranges, choices and lookups (checked against Dataverse in batches), preview the transformed values before importing, report unmapped columns without stopping, and export row-level errors with suggested corrections to Excel or CSV. Mappings are saved as reusable, shareable profiles.</description>
    <summary>Validate Excel/CSV migration files against Dataverse metadata before importing: mapping, required fields, types, choices, lookups, preview and corrected exports.</summary>
    <releaseNotes>1.2026.10.1: First release.
- Excel (.xlsx/.xlsm) and CSV input with sheet and header-row selection
- Auto-mapping by display name, logical name, schema name, abbreviations and similarity
- Validation of required columns, text length and e-mail/URL formats, numbers, ranges and precision, dates, Yes/No, choices, multi-select choices, status/status reason pairs, lookups and duplicate keys
- Transforms, value maps and default values per column
- Preview of transformed values, issues list with suggested fixes
- Export to Excel (summary, issues, data with fixes, preview) or CSV; import template generator
- Reusable mapping profiles</releaseNotes>
    <copyright>Copyright © Vikash Kumar 2026</copyright>
    <!-- "XrmToolBox" must be the first tag for the tool to appear in the XrmToolBox Tool Library -->
    <tags>XrmToolBox DataQuality Validation Import Migration Excel CSV Mapping Dataverse Dynamics365 PowerApps</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <!-- Host version marker required by the Tool Library -->
        <dependency id="XrmToolBox" version="1.2025.10.74" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\net48\DataQualityStudio.dll" target="lib\net48\Plugins\DataQualityStudio.dll" />
    <file src="Resources\icon128.png" target="images\icon.png" />
    <file src="..\..\README.md" target="docs\README.md" />
  </files>
</package>
