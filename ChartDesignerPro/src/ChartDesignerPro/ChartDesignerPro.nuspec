<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata minClientVersion="5.3">
    <!-- Package id must be unique on nuget.org; keep it stable once published -->
    <id>VikashKumar.XrmToolBox.ChartDesignerPro</id>
    <!-- Keep in sync with <Version> in ChartDesignerPro.csproj (format 1.YYYY.M.rev) -->
    <version>1.2026.11.1</version>
    <title>Chart Designer Pro</title>
    <authors>Vikash Kumar</authors>
    <owners>vikashkumar669</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/vikashkumar669/XrmTools/tree/main/ChartDesignerPro</projectUrl>
    <repository type="git" url="https://github.com/vikashkumar669/XrmTools.git" branch="main" />
    <!-- Icon by URL only (same as Data Quality Studio and Diagnostics Workbench): GitHub serves it as image/png. When the icon is
         embedded, nuget.org sometimes stores it as application/octet-stream, which the XrmToolBox portal rejects ("Logo Url is not valid"). -->
    <iconUrl>https://raw.githubusercontent.com/vikashkumar669/XrmTools/main/ChartDesignerPro/src/ChartDesignerPro/Resources/icon128.png</iconUrl>
    <readme>docs\README.md</readme>
    <description>Chart Designer Pro is a chart studio for Dataverse model-driven app charts. Browse system and personal charts by table, see what each chart shows in plain words, and edit its data description (FetchXML, categories, measures) and presentation XML in an editor with find/replace, formatting and live error locations. 25 validation checks cover structure, FetchXML, column metadata and Unified Interface compatibility. Save changes back safely: validation first, a conflict check, a confirmation showing the environment, URL and diff, a backup of the current version, only the changed columns written, a publish of only the chart's table, and a read-back check. Import and export chart files (including the app's Export Chart format), export the chart list as CSV, and keep local backups. Power BI, web-resource and non-customizable managed charts are shown read-only.</description>
    <summary>Inspect, validate, edit and safely save Dataverse model-driven app charts.</summary>
    <releaseNotes>1.2026.11.1: First release.
- Chart Explorer for system and personal charts: table filter, search, sort, paged loading with cancel
- Favourites and recently opened charts
- Summary tab: plain-language explanation of each chart
- XML editor with colouring, line numbers, undo/redo, find/replace, format and live well-formed status
- Safe save to Dataverse: validation gate, conflict check, confirmation showing environment, URL and diff, backup first, changed columns only, scoped publish of the chart's table, read-back verification
- Validation: 25 checks (structure, FetchXML, metadata, Unified Interface compatibility) with explanations and go-to-line
- Diff of your edits against the stored XML
- Import and export (JSON, chart XML, data or presentation XML), chart list as CSV, local backups
- Settings saved per connection</releaseNotes>
    <copyright>Copyright © Vikash Kumar 2026</copyright>
    <!-- "XrmToolBox" must be the first tag for the tool to appear in the XrmToolBox Tool Library -->
    <tags>XrmToolBox Charts Chart Visualization ChartXML FetchXML Designer Dataverse Dynamics365 PowerApps ModelDriven</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <!-- Host version marker required by the Tool Library -->
        <dependency id="XrmToolBox" version="1.2025.10.74" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\net48\ChartDesignerPro.dll" target="lib\net48\Plugins\ChartDesignerPro.dll" />
    <file src="..\..\README.md" target="docs\README.md" />
  </files>
</package>
